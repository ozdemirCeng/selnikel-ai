# Selnikel AI Environment Configuration

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3005
POSTGRES_PORT=5432
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=selnikel_ai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/selnikel_ai

# Qdrant
QDRANT_HOST=localhost
QDRANT_COLLECTION_NAME=selnikel_docs

# LLM Provider Configuration (openai / ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Local Ollama fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embedding Provider
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
