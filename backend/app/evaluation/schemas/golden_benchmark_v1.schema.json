{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selnikel Golden Benchmark Dataset v1.0 Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "category",
      "question",
      "is_safety_critical",
      "is_out_of_domain",
      "dataset_version",
      "synthetic",
      "review_status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^selnikel-bench-\\d{3}$"
      },
      "category": {
        "type": "string",
        "enum": [
          "capacity_pressure_temp",
          "maintenance_intervals",
          "fault_troubleshooting",
          "parts_compatibility",
          "standards_compliance",
          "revision_conflicts",
          "out_of_domain",
          "safety_critical"
        ]
      },
      "question": {
        "type": "string",
        "minLength": 5
      },
      "is_safety_critical": {
        "type": "boolean"
      },
      "is_out_of_domain": {
        "type": "boolean"
      },
      "abstention_expected": {
        "type": "boolean"
      },
      "expected_abstention_reason": {
        "type": "string",
        "enum": [
          "out_of_domain",
          "insufficient_context",
          "obsolete_revision",
          "safety_ambiguity",
          "none"
        ]
      },
      "expected_evidence": {
        "type": ["object", "null"],
        "properties": {
          "document_name": {
            "type": "string",
            "minLength": 1
          },
          "document_sha256": {
            "type": ["string", "null"]
          },
          "revision_code": {
            "type": ["string", "null"]
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": ["string", "null"]
          },
          "locator": {
            "type": "object",
            "required": ["locator_type"],
            "properties": {
              "locator_type": {
                "type": "string",
                "enum": ["table_cell", "section_text"]
              },
              "table_id": { "type": "string" },
              "row_key": { "type": "string" },
              "column_name": { "type": "string" },
              "section_header": { "type": "string" },
              "key_phrase": { "type": "string" }
            },
            "additionalProperties": false
          },
          "expected_numerical_parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ground_truth_answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_name",
          "page_number",
          "ground_truth_answer",
          "expected_numerical_parameters"
        ],
        "additionalProperties": false
      },
      "expert_reviewer": {
        "type": ["string", "null"]
      },
      "dataset_version": {
        "type": "string",
        "default": "1.0.0"
      },
      "anonymized": {
        "type": "boolean",
        "default": true
      },
      "synthetic": {
        "type": "boolean",
        "default": true
      },
      "review_status": {
        "type": "string",
        "enum": [
          "unverified_draft",
          "verified_expert_reviewed",
          "deprecated"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "is_out_of_domain": { "const": true } }
        },
        "then": {
          "required": ["abstention_expected", "expected_abstention_reason"],
          "properties": {
            "abstention_expected": { "const": true },
            "expected_abstention_reason": { "const": "out_of_domain" },
            "expected_evidence": { "type": "null" }
          }
        }
      },
      {
        "if": {
          "properties": { "is_out_of_domain": { "const": false } }
        },
        "then": {
          "required": ["expected_evidence"],
          "properties": {
            "expected_evidence": { "type": "object" }
          }
        }
      },
      {
        "if": {
          "properties": { "review_status": { "const": "verified_expert_reviewed" } }
        },
        "then": {
          "required": ["expert_reviewer"],
          "properties": {
            "synthetic": { "const": false }
          }
        }
      }
    ],
    "additionalProperties": false
  }
}